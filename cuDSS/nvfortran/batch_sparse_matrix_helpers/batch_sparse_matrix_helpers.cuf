! CUDA Fortran port: cudafor device arrays + pointer tables via = copies.

program main
  use iso_fortran_env, only: wp => real64
  use iso_c_binding, only: c_int64_t, c_ptr, c_loc, c_f_pointer, c_associated
  use cudafor
  use cudss
  implicit none

  integer, parameter :: batchCount = 2
  integer, parameter :: n1 = 5, n2 = 6, nnz1 = 8, nnz2 = 11
  integer, parameter :: nnz1b = 7, nnz2b = 10

  integer :: csr1_offsets(n1+1), csr1_columns(nnz1), csr2_offsets(n2+1), csr2_columns(nnz2)
  real(wp) :: csr1_values(nnz1), csr2_values(nnz2)
  integer :: csr1_offsets_b(n1+1), csr1_columns_b(nnz1b), csr2_offsets_b(n2+1), csr2_columns_b(nnz2b)
  real(wp) :: csr1_values_b(nnz1b), csr2_values_b(nnz2b)
  real(wp) :: h1_val_b(max(nnz1, nnz1b)), h2_val_b(max(nnz2, nnz2b))
  real(wp) :: hb1(n1), hb2(n2), hb1_b(n1), hb2_b(n2)

  integer, device, allocatable, target :: csr1_offsets_d(:), csr1_columns_d(:), csr2_offsets_d(:), csr2_columns_d(:)
  real(wp), device, allocatable, target :: csr1_values_d(:), csr2_values_d(:), d1_val_b(:), d2_val_b(:)
  real(wp), device, allocatable, target :: hb1_d(:), hb2_d(:), hb1_db(:), hb2_db(:)
  integer, device, allocatable, target :: csr1_offsets_db(:), csr1_columns_db(:), csr2_offsets_db(:), csr2_columns_db(:)

  type(c_ptr), allocatable, target :: p_off(:), p_col(:), p_val(:), p_b(:)
  type(c_ptr), allocatable, target :: p_off_b(:), p_col_b(:), p_val_b(:), p_b_b(:)
  type(c_ptr), device, allocatable, target :: p_off_d(:), p_col_d(:), p_val_d(:), p_b_d(:)
  type(c_ptr), device, allocatable, target :: p_off_db(:), p_col_db(:), p_val_db(:), p_b_db(:)

  integer :: nrows(batchCount), ncols(batchCount), nnz(batchCount), nrhs(batchCount), ldb(batchCount)
  integer(c_int64_t) :: bc_out
  integer(c_int) :: offsetType_out, indexType_out, valueType_out
  type(cudssMatrixType) :: mtype_out
  type(cudssMatrixViewType) :: mview_out
  type(cudssIndexBase) :: indexBase_out
  integer(c_int) :: indexType_out_b, valueType_out_b
  type(cudssLayout) :: layout_out_b
  type(c_ptr) :: nnz_out
  type(c_ptr) :: off_out, col_out, val_out, b_val_out
  type(cudssHandle) :: handle
  type(cudssConfig) :: cfg
  type(cudssData) :: dat
  type(cudssMatrix) :: A, b
  type(cudssStatus) :: st
  type(cudssMatrixType) :: mtype = CUDSS_MTYPE_SPD
  type(cudssMatrixViewType) :: mview = CUDSS_MVIEW_UPPER
  type(cudssIndexBase) :: base = CUDSS_BASE_ONE
  type(cudssMatrixFormat) :: mf
  integer(cuda_stream_kind) :: stream
  integer :: status
  real(wp) :: new_csr(2), new_b(2), out_csr(2), out_b(2)

  allocate(csr1_offsets_d(n1+1), csr1_columns_d(nnz1), csr1_values_d(nnz1))
  allocate(csr2_offsets_d(n2+1), csr2_columns_d(nnz2), csr2_values_d(nnz2))
  allocate(hb1_d(n1), hb2_d(n2), d1_val_b(max(nnz1, nnz1b)), d2_val_b(max(nnz2, nnz2b)))
  allocate(hb1_db(n1), hb2_db(n2))
  allocate(p_off(batchCount), p_col(batchCount), p_val(batchCount), p_b(batchCount))
  allocate(p_off_b(batchCount), p_col_b(batchCount), p_val_b(batchCount), p_b_b(batchCount))
  allocate(p_off_d(batchCount), p_col_d(batchCount), p_val_d(batchCount), p_b_d(batchCount))
  allocate(p_off_db(batchCount), p_col_db(batchCount), p_val_db(batchCount), p_b_db(batchCount))

  csr1_offsets = [1, 3, 5, 7, 8, 9]
  csr1_columns = [1, 3, 2, 3, 3, 5, 4, 5]
  csr1_values = [4.0_wp, 1.0_wp, 3.0_wp, 2.0_wp, 5.0_wp, 1.0_wp, 1.0_wp, 2.0_wp]
  csr2_offsets = [1, 3, 5, 8, 9, 11, 12]
  csr2_columns = [1, 6, 2, 5, 3, 5, 4, 6, 5, 6, 6]
  csr2_values = [3.0_wp, 1.0_wp, 2.0_wp, 1.0_wp, 6.0_wp, 2.0_wp, 2.0_wp, 5.0_wp, 7.0_wp, 3.0_wp, 8.0_wp]
  hb1 = [7.0_wp, 12.0_wp, 25.0_wp, 4.0_wp, 13.0_wp]
  hb2 = [9.0_wp, 9.0_wp, 40.0_wp, 20.0_wp, 61.0_wp, 70.0_wp]

  csr1_offsets_d = csr1_offsets; csr1_columns_d = csr1_columns; csr1_values_d = csr1_values
  csr2_offsets_d = csr2_offsets; csr2_columns_d = csr2_columns; csr2_values_d = csr2_values
  hb1_d = hb1; hb2_d = hb2

  p_off(1) = c_loc(csr1_offsets_d(1)); p_off(2) = c_loc(csr2_offsets_d(1))
  p_col(1) = c_loc(csr1_columns_d(1)); p_col(2) = c_loc(csr2_columns_d(1))
  p_val(1) = c_loc(csr1_values_d(1)); p_val(2) = c_loc(csr2_values_d(1))
  p_b(1) = c_loc(hb1_d(1)); p_b(2) = c_loc(hb2_d(1))
  p_off_d = p_off; p_col_d = p_col; p_val_d = p_val; p_b_d = p_b

  d1_val_b(1:nnz1) = csr1_values; d2_val_b(1:nnz2) = csr2_values
  hb1_db = hb1; hb2_db = hb2
  p_off_b = p_off; p_col_b = p_col
  p_val_b(1) = c_loc(d1_val_b(1)); p_val_b(2) = c_loc(d2_val_b(1))
  p_b_b(1) = c_loc(hb1_db(1)); p_b_b(2) = c_loc(hb2_db(1))
  p_off_db = p_off_b; p_col_db = p_col_b; p_val_db = p_val_b; p_b_db = p_b_b

  nrows = [n1, n2]; ncols = [n1, n2]; nnz = [nnz1, nnz2]; nrhs = [1, 1]; ldb = nrows

  status = cudaStreamCreate(stream)
  st = cudssCreate(handle); st = cudssSetStream(handle, stream)
  st = cudssConfigCreate(cfg); st = cudssDataCreate(handle, dat)

  st = cudssMatrixCreateBatchDn(b, int(batchCount,8), nrows, nrhs, ldb, c_loc(p_b_d(1)), &
       CUDSS_R_32I, CUDSS_R_64F, CUDSS_LAYOUT_COL_MAJOR)
  st = cudssMatrixCreateBatchCsr(A, int(batchCount,8), nrows, ncols, nnz, &
       c_loc(p_off_d(1)), c_loc(p_col_d(1)), c_loc(p_val_d(1)), &
       CUDSS_R_32I, CUDSS_R_32I, CUDSS_R_64F, mtype, mview, base)

  ! Note: cuDSS matrix objects are lightweight wrappers around the user data.
  st = cudssMatrixGetBatchCsr(A, batchCount=bc_out, rowStart=off_out, colIndices=col_out, &
       values=val_out, offsetType=offsetType_out, indexType=indexType_out, &
       valueType=valueType_out, mtype=mtype_out, mview=mview_out, indexBase=indexBase_out)
  if (bc_out /= int(batchCount,8) .or. .not. c_associated(off_out, c_loc(p_off_d(1))) .or. &
       .not. c_associated(col_out, c_loc(p_col_d(1))) .or. .not. c_associated(val_out, c_loc(p_val_d(1))) .or. &
       offsetType_out /= CUDSS_R_32I .or. indexType_out /= CUDSS_R_32I .or. &
       valueType_out /= CUDSS_R_64F .or. mtype_out /= mtype .or. mview_out /= mview .or. &
       indexBase_out /= base) error stop 2
  print *, 'Success: Check for matrix A from cudssMatrixGetBatchCsr passed'

  st = cudssMatrixGetBatchDn(b, batchCount=bc_out, values=b_val_out, integerType=indexType_out_b, &
       valueType=valueType_out_b, layout=layout_out_b)
  if (bc_out /= int(batchCount,8) .or. .not. c_associated(b_val_out, c_loc(p_b_d(1))) .or. &
       indexType_out_b /= CUDSS_R_32I .or. valueType_out_b /= CUDSS_R_64F &
       .or. layout_out_b /= CUDSS_LAYOUT_COL_MAJOR) error stop 2
  print *, 'Success: Check for matrix B from cudssMatrixGetBatchDn passed'

  new_csr = [-4.0_wp, -3.0_wp]; new_b = [-2.0_wp, -5.0_wp]
  d1_val_b(1) = new_csr(1); d2_val_b(1) = new_csr(2)
  hb1_db(1) = new_b(1); hb2_db(1) = new_b(2)
  p_val_b(1) = c_loc(d1_val_b(1)); p_val_b(2) = c_loc(d2_val_b(1))
  p_b_b(1) = c_loc(hb1_db(1)); p_b_b(2) = c_loc(hb2_db(1))
  p_val_db = p_val_b; p_b_db = p_b_b

  st = cudssMatrixSetBatchValues(A, c_loc(p_val_db(1)))
  st = cudssMatrixSetBatchValues(b, c_loc(p_b_db(1)))

  out_csr(1) = d1_val_b(1)
  out_csr(2) = d2_val_b(1)
  out_b(1) = hb1_db(1)
  out_b(2) = hb2_db(1)
  if (any(abs(out_csr - new_csr) > epsilon(1.0_wp)) .or. any(abs(out_b - new_b) > epsilon(1.0_wp))) error stop 3

  csr1_offsets_b = [1, 3, 5, 6, 7, 8]
  csr1_columns_b = [1, 3, 2, 3, 3, 4, 5]
  csr1_values_b = [4.0_wp, 1.0_wp, 3.0_wp, 2.0_wp, 5.0_wp, 1.0_wp, 2.0_wp]
  csr2_offsets_b = [1, 3, 5, 7, 8, 10, 11]
  csr2_columns_b = [1, 6, 2, 5, 3, 5, 4, 5, 6, 6]
  csr2_values_b = [3.0_wp, 1.0_wp, 2.0_wp, 1.0_wp, 6.0_wp, 2.0_wp, 5.0_wp, 7.0_wp, 3.0_wp, 8.0_wp]

  allocate(csr1_offsets_db(n1+1), csr1_columns_db(nnz1b), csr2_offsets_db(n2+1), csr2_columns_db(nnz2b))
  csr1_offsets_db = csr1_offsets_b; csr1_columns_db = csr1_columns_b
  csr2_offsets_db = csr2_offsets_b; csr2_columns_db = csr2_columns_b
  d1_val_b(1:nnz1b) = csr1_values_b; d2_val_b(1:nnz2b) = csr2_values_b
  p_off_b(1) = c_loc(csr1_offsets_db(1)); p_off_b(2) = c_loc(csr2_offsets_db(1))
  p_col_b(1) = c_loc(csr1_columns_db(1)); p_col_b(2) = c_loc(csr2_columns_db(1))
  p_val_b(1) = c_loc(d1_val_b(1)); p_val_b(2) = c_loc(d2_val_b(1))
  p_off_db = p_off_b; p_col_db = p_col_b; p_val_db = p_val_b

  st = cudssMatrixSetBatchCsrPointers(A, c_loc(p_off_db(1)), c_loc(p_col_db(1)), c_loc(p_val_db(1)))

  ! Note: changing the matrix structure does not change the nnz returned by
  ! cudssMatrixGetBatchCsr; the original nnz array passed to cudssMatrixCreateBatchCsr
  ! is still returned.
  st = cudssMatrixGetBatchCsr(A, nnz=nnz_out)
  block
    integer, pointer :: nnz_new(:)
    call c_f_pointer(nnz_out, nnz_new, [batchCount])
    if (any(nnz_new /= nnz)) error stop 6
  end block

  st = cudssMatrixGetFormat(A, mf)
  if (iand(mf%val, CUDSS_MFORMAT_CSR%val) == 0 .or. iand(mf%val, CUDSS_MFORMAT_BATCH%val) == 0) error stop 4
  st = cudssMatrixGetFormat(b, mf)
  if (iand(mf%val, CUDSS_MFORMAT_DENSE%val) == 0 .or. iand(mf%val, CUDSS_MFORMAT_BATCH%val) == 0) error stop 5

  st = cudssMatrixDestroy(A); st = cudssMatrixDestroy(b)
  st = cudssDataDestroy(handle, dat); st = cudssConfigDestroy(cfg); st = cudssDestroy(handle)
  status = cudaStreamDestroy(stream)

  deallocate(csr1_offsets_d, csr1_columns_d, csr1_values_d, csr2_offsets_d, csr2_columns_d, csr2_values_d)
  deallocate(hb1_d, hb2_d, d1_val_b, d2_val_b, hb1_db, hb2_db)
  deallocate(csr1_offsets_db, csr1_columns_db, csr2_offsets_db, csr2_columns_db)
  deallocate(p_off, p_col, p_val, p_b, p_off_b, p_col_b, p_val_b, p_b_b)
  deallocate(p_off_d, p_col_d, p_val_d, p_b_d, p_off_db, p_col_db, p_val_db, p_b_db)

  print *, 'Example cudss_batch_sparse_matrix_helpers PASSED'
end program main
