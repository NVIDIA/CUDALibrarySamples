!
! CUDA Fortran port: cudafor device arrays + = for host/device copies.

program main
  ! This example demonstrates basic usage of cuDSS APIs for extracting
  ! the row and column reordering information that is generated in the
  ! REORDERING phase.
  ! A system of linear algebraic equations with a sparse matrix is solved
  ! to show the extraction process:
  !                             Ax = b,
  ! where:
  !     A is the sparse input matrix,
  !     b is the (dense) right-hand side vector (or a matrix),
  !     x is the (dense) solution vector (or a matrix).
  ! Matches examples/cudss_reordering_phase.cpp.
  use iso_c_binding, only: c_loc, c_intptr_t
  use cudafor
  use cudss
  use cudssutils
  use validation
  
  implicit none

  ! 5x5 matrix
  integer, parameter :: n=5
  integer, parameter :: nnz=8
  integer, parameter :: nrhs=1

  integer, parameter :: nrows = n, ncols = n
  integer, parameter :: ldb = nrows, ldx = ncols
  
  integer, allocatable :: csr_offsets(:), csr_columns(:)
  integer, device, allocatable, target :: csr_offsets_d(:)
  integer, device, allocatable, target :: csr_columns_d(:)
   real(8), device, allocatable, target :: csr_values_d(:)
   real(8), device, allocatable, target :: x_values_d(:)
   real(8), device, allocatable, target :: b_values_d(:)
  real(8), allocatable :: csr_values(:), x_values(:), b_values(:)
  

  type(cudssHandle) :: h
  type(cudssConfig) :: solverConfig
  type(cudssData) :: solverData
  type(cudssStatus) :: statusDSS
  type(cudssMatrix) :: b, x

  type(cudssMatrix) :: A
  type(cudssMatrixType) :: mtype = CUDSS_MTYPE_SPD
  type(cudssMatrixViewType) :: mview = CUDSS_MVIEW_UPPER
  type(cudssIndexBase) :: base = CUDSS_BASE_ONE

  integer :: status
  integer(cuda_stream_kind) :: stream
  integer :: c
  real(8), parameter :: tol = 1.d-11

  ! property types

  print "('Maj/Min/Patch:', 3(1x, i0))", CUDSS_VERSION_MAJOR, CUDSS_VERSION_MINOR, CUDSS_VERSION_PATCH
  
  allocate(&
       csr_offsets(n+1), &
       csr_columns(nnz), &
       csr_values(nnz), &
       x_values(nrhs*n), &
       b_values(nrhs*n))

  ! Symmetric matrix with upper triangular elements stored
  !
  ! Full matrix problem is:
  ! 
  !  4 0 1 0 0       7
  !  0 3 2 0 0      12
  !  1 2 5 0 1  X = 25
  !  0 0 0 1 0       4
  !  0 0 1 0 2      13

  csr_offsets = [1,3,5,7,8,9]
  csr_columns = [1,3,2,3,3,5,4,5]
  csr_values = [4.0, 1.0, 3.0, 2.0, 5.0, 1.0, 1.0, 2.0]
  b_values = [7.0, 12.0, 25.0, 4.0, 13.0]
  x_values = 0.0d0
  allocate(csr_offsets_d(size(csr_offsets)))
  csr_offsets_d = csr_offsets
  allocate(csr_columns_d(size(csr_columns)))
  csr_columns_d = csr_columns
  allocate(csr_values_d(size(csr_values)))
  csr_values_d = csr_values
  allocate(b_values_d(size(b_values)))
  b_values_d = b_values
  allocate(x_values_d(size(x_values)))
  x_values_d = x_values

  
  status = cudaStreamCreate(stream)
  if (status /= cudaSuccess) print *, 'cudaStreamCreate: ', status

  statusDSS = cudssCreate(h)
  if (statusDSS /= cudss_status_success) print *, 'cudssCreate: ', statusDSS

  statusDSS = cudssSetStream(h, stream)
  if (statusDSS /= cudss_status_success) print *, 'cudssSetStream: ', statusDSS

  statusDSS = cudssConfigCreate(solverConfig)
  if (statusDSS /= cudss_status_success) print *, 'cudssConfigCreate: ', statusDSS

  statusDSS = cudssDataCreate(h, solverData)
  if (statusDSS /= cudss_status_success) print *, 'cudssDataCreate: ', statusDSS

  statusDSS = cudssMatrixCreateDn(b, int(nrows,8), int(nrhs,8), int(ldb,8), &
       c_loc(b_values_d(1)), CUDSS_R_64F, CUDSS_LAYOUT_COL_MAJOR)
  if (statusDSS /= cudss_status_success) print *, 'cudssMatrixCreate for b:', statusDSS

  print *, 'Printing b ***'
  call printMatrix(b)

  statusDSS = cudssMatrixCreateDn(x, int(ncols,8), int(nrhs,8), int(ldx,8), &
       c_loc(x_values_d(1)), CUDSS_R_64F, CUDSS_LAYOUT_COL_MAJOR)
  if (statusDSS /= cudss_status_success) print *, 'cudssMatrixCreateDn for x: ', statusDSS
  
  statusDSS = cudssMatrixCreateCsr(A, &
       int(nrows,8), int(ncols,8), int(nnz,8), &
       c_loc(csr_offsets_d(1)), c_loc(csr_columns_d(1)), c_loc(csr_values_d(1)), &
       CUDSS_R_32I, CUDSS_R_32I, CUDSS_R_64F, &
       mtype, mview, base)
  if (statusDSS /= cudss_status_success) print *, 'cudssMatrixCreateCsr for A: ', statusDSS
  
  print *, 'Printing A ***'
  call printMatrix(A)

  ! Generate the reordering isolated
  statusDSS = cudssExecute(h, CUDSS_PHASE_REORDERING, &
       solverConfig, solverData, A, x, b)
  if (statusDSS /= cudss_status_success) print *, 'cudssExecute phase analysis: ', statusDSS

  block
    integer(c_size_t) :: rowSizeWritten, colSizeWritten
    integer :: rowPerm(n), colPerm(n)
    integer :: rowPermExpected(n) = [5, 4, 2, 1, 3]
    integer :: colPermExpected(n) = [5, 4, 2, 1, 3]

    statusDSS = cudssDataGet(h, solverData, CUDSS_DATA_PERM_REORDER_ROW, &
         rowPerm, c_sizeof(rowPerm), rowSizeWritten)
    if (statusDSS /= cudss_status_success) print *, 'cudssDataGet rowPerm: ', statusDSS

    statusDSS = cudssDataGet(h, solverData, CUDSS_DATA_PERM_REORDER_COL, &
         colPerm, c_sizeof(colPerm), colSizeWritten)
    if (statusDSS /= cudss_status_success) print *, 'cudssDataGet colPerm: ', statusDSS

    print *, 'rowPerm: ', rowPerm
    if (any(rowPerm /= rowPermExpected)) then
       print *, 'rowPerm error ***'
       print *, 'rowPermExpected: ', rowPermExpected
    end if

    print *, 'colPerm: ', colPerm
    if (any(colPerm /= colPermExpected)) then
       print *, 'colPerm error ***'
       print *, 'colPermExpected: ', colPermExpected
    end if
  end block

  ! Finish the rest of the solve
  block
    type(cudssPhase) :: ph
    ph%val = ior(ior(CUDSS_PHASE_SYMBOLIC_FACTORIZATION%val, CUDSS_PHASE_FACTORIZATION%val), &
         CUDSS_PHASE_SOLVE%val)
    statusDSS = cudssExecute(h, ph, solverConfig, solverData, A, x, b)
    if (statusDSS /= cudss_status_success) print *, 'cudssExecute for everything combined: ', statusDSS
  end block

  status = cudaStreamSynchronize(stream)
  if (statusDSS /= cudss_status_success) print *, 'cudaStreamSynchronize: ', status

  x_values = x_values_d

  print *, 'x: '
  do c = 1, ncols
     print *, c, x_values(c)
  end do

  if (.not. validate_spd_upper_solution_r64(n, csr_offsets, csr_columns, csr_values, x_values, b_values, tol)) &
       error stop 1

  ! cleanup

  statusDSS = cudssMatrixDestroy(A)
  if (statusDSS /= cudss_status_success) print *, 'cudssMatrixDestroy(A): ', statusDSS
  statusDSS = cudssMatrixDestroy(b)
  if (statusDSS /= cudss_status_success) print *, 'cudssMatrixDestroy(b): ', statusDSS
  statusDSS = cudssMatrixDestroy(x)
  if (statusDSS /= cudss_status_success) print *, 'cudssMatrixDestroy(x): ', statusDSS
  statusDSS = cudssDataDestroy(h, solverData)
  if (statusDSS /= cudss_status_success) print *, 'cudssDataDestroy(h,solverData): ', statusDSS  
  statusDSS = cudssConfigDestroy(solverConfig)
  if (statusDSS /= cudss_status_success) print *, 'cudssConfigDestroy(solverConfig): ', statusDSS
  statusDSS = cudssDestroy(h)
  if (statusDSS /= cudss_status_success) print *, 'cudssDestroy: ', statusDSS
  status = cudaStreamDestroy(stream)
  if (status /= cudaSuccess) print *, 'cudaStreamDestroy: ', status
  
  deallocate(csr_offsets, csr_columns, csr_values, x_values, b_values)
  deallocate(csr_offsets_d, csr_columns_d, csr_values_d, x_values_d, b_values_d)

  print *, 'Example cudss_reordering_phase PASSED'
end program main
  
